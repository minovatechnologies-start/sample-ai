# Review the exact model card and its license/access terms before running anything.
MODEL_ID=Qwen/Qwen2.5-Coder-0.5B-Instruct
MODEL_LICENSE=Apache-2.0
MODEL_LICENSE_REVIEWED=true
ADAPTER_PATH=models/v1/adapter
ADAPTER_OUTPUT_DIR=models/v1/adapter
API_KEY=
HF_TOKEN=

RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
TRAIN_LANGUAGES=python
DATASET_SOURCE_NAME=Minova Technologies Enterprise
DATASET_SOURCE_URI=internal://minova-technologies-enterprise/datasets.json
DATASET_LICENSE=Minova-Proprietary
TRAIN_FILE=data/processed/train.jsonl
VALIDATION_FILE=data/processed/validation.jsonl
USE_4BIT=false
NUM_TRAIN_EPOCHS=1
TRAIN_BATCH_SIZE=1
EVAL_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=0.0002
MAX_SEQ_LENGTH=1024
MAX_NEW_TOKENS=256
LORA_R=8
LORA_ALPHA=16
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,v_proj

# Optional per-language overrides; images must be pre-pulled manually.
